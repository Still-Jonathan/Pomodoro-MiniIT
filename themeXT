THEMES = {
    "savana": {
        "bg": "#EAD7A1",        # warm savana sand
        "fg": "#3B2F2F",        # dark brown text
        "button_bg": "#8D7539",
        "button_fg": "#FFFFFF"
    
    },
    "water": {
        "bg": "#D0ECF2",        # light water blue
        "fg": "#003B44",        # deep blue text
        "button_bg": "#4FA3B5",
        "button_fg": "#FFFFFF"
      
    }
}


class PomodoroApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Pomodoro Theme")
        self.root.geometry("300x200")

        self.current_theme = "savana"

        self.label = tk.Label(root, text="Pomodoro Timer", font=("Arial", 24))
        self.label.pack(pady=20)

        self.switch_btn = tk.Button(
            root,
            text="Switch Theme",
            command=self.switch_theme
        )
        self.switch_btn.pack(pady=10)

        self.apply_theme(self.current_theme)

   
    def apply_theme(self, theme_name):
        theme = THEMES[theme_name]

        self.root.configure(bg=theme["bg"])
        self.label.configure(
            bg=theme["bg"],
            fg=theme["fg"]
        )
        self.switch_btn.configure(
            bg=theme["button_bg"],
            fg=theme["button_fg"],
            activebackground=theme["fg"],
            activeforeground=theme["bg"]
        )
        
  

   
    def switch_theme(self):
        if self.current_theme == "savana":
            self.current_theme = "water"
        else:
            self.current_theme = "savana"

        self.apply_theme(self.current_theme)



root = tk.Tk()
root.geometry("300x200")
app = PomodoroApp(root)
root.mainloop()