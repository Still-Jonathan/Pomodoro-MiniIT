import tkinter as tk
import pygame
from threading import Thread
import time


pygame.mixer.init()
pygame.mixer.music.set_volume(1.0)

def play_music(file):
    pygame.mixer.music.load(file)
    pygame.mixer.music.play(-1)

def stop_music():
    pygame.mixer.music.stop()


SOUNDS = {
    "Savana": r"Audio/savana.mp3",
    "Rain": r"Audio/Rain.mp3",
    "Waterfall": r"Audio/waterfall.mp3"
}


class PomodoroApp:
    def __init__(self, root, timeleft):
        self.root = root
        self.root.title("Music Pomodoro")

        self.time_left = timeleft
        self.running = False
        self.current_sound = "Savana"

        self.label = tk.Label(root, text=str(timeleft), font=("Arial", 40))
        self.label.pack(pady=20)

        self.sound_var = tk.StringVar(value="Savana")
        self.sound_menu = tk.OptionMenu(
            root, self.sound_var, *SOUNDS.keys(), command=self.change_music
        )
        self.sound_menu.pack(pady=5)

        #VOLUME SLIDER
        self.volume_var = tk.IntVar(value=100)
        self.volume_slider = tk.Scale(
            root,
            from_=0,
            to=100,
            orient="horizontal",
            label="Volume",
            variable=self.volume_var,
            command=self.change_volume
        )
        self.volume_slider.pack(pady=5)

        self.start_btn = tk.Button(root, text="Start", command=self.start_timer)
        self.start_btn.pack()

        self.stop_btn = tk.Button(root, text="Stop", command=self.stop_timer)
        self.stop_btn.pack()

    def change_music(self, selected):
        self.current_sound = selected
        if self.running:
            play_music(SOUNDS[self.current_sound])

    def change_volume(self, value):
        pygame.mixer.music.set_volume(int(value) / 100)

    def start_timer(self):
        if not self.running:
            self.running = True
            play_music(SOUNDS[self.current_sound])
            Thread(target=self.run_timer, daemon=True).start()

    def stop_timer(self):
        self.running = False
        stop_music()
        self.label.config(text="Stopped")

    def run_timer(self):
        remaining = self.time_left
        while remaining > 0 and self.running:
            self.label.config(text=str(remaining))
            time.sleep(1)
            remaining -= 1

        stop_music()
        self.label.config(text="Done!")


root = tk.Tk()
app = PomodoroApp(root, 10)
root.mainloop()

