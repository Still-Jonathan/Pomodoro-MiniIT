import tkinter as tk
import pygame
from threading import Thread
import time

#MUSIC SETUP
pygame.mixer.init()

def play_music(file):
    pygame.mixer.music.load(file)
    pygame.mixer.music.play(-1)  

def stop_music():
    pygame.mixer.music.stop()


#FILE PATHS
savana = r"savana.mp3"
rain = r"Rain.mp3"
waterfall = r"waterfall.mp3"


#TIMER LOGIC
class PomodoroApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Music Pomodoro")

        self.time_left = 130
        self.running = False

        self.label = tk.Label(root, text="10", font=("Arial", 40))
        self.label.pack(pady=20)

        self.start_btn = tk.Button(root, text="Start", command=self.start_savana)
        self.start_btn.pack()

        self.stop_btn = tk.Button(root, text="Stop", command=self.stop_timer)
        self.stop_btn.pack()

    def start_savana(self):
        self.start_timer(savana)

    def start_timer(self, music_file):
        if not self.running:
            self.running = True
            play_music(music_file)
            Thread(target=self.run_timer, daemon=True).start()

    def stop_timer(self):
        self.running = False
        stop_music()
        self.label.config(text="Stopped")

    def run_timer(self):
        remaining = self.time_left
        while remaining > 0 and self.running:
            self.label.config(text=str(remaining))
            time.sleep(1)
            remaining -= 1

        stop_music()
        self.label.config(text="Done!") 


#RUN APP
root = tk.Tk()
app = PomodoroApp(root)
root.mainloop()
